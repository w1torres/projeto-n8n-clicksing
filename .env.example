# =============================================================================
# N8N
# =============================================================================
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque_esta_senha

# =============================================================================
# POSTGRES — banco interno do n8n (fila/execuções/credenciais)
# =============================================================================
DB_N8N_USER=n8n
DB_N8N_PASSWORD=troque_esta_senha_n8n

# =============================================================================
# POSTGRES — banco da aplicação (tabelas assinaturas / auditoria_assinaturas)
# =============================================================================
DB_APP_HOST=postgres_custom
DB_APP_PORT=5432
DB_APP_NAME=assinatura
DB_APP_USER=app_user
DB_APP_PASSWORD=troque_esta_senha_app

# =============================================================================
# CLICKSIGN — API v3 (JSON:API)
# Doc: https://developers.clicksign.com/reference
# Sandbox: https://sandbox.clicksign.com | Produção: https://app.clicksign.com
# Header de auth é "Authorization: <token>" (SEM "Bearer").
# =============================================================================
CLICKSIGN_ENV=sandbox
CLICKSIGN_API_URL_SANDBOX=https://sandbox.clicksign.com/api/v3
CLICKSIGN_API_URL_PRODUCTION=https://app.clicksign.com/api/v3
CLICKSIGN_API_TOKEN=

# Pasta (folder) do ClickSign onde os envelopes serão criados. Opcional —
# deixe em branco para criar na raiz da conta. Para descobrir o UUID de uma
# pasta existente, importe o Workflow 1 e execute manualmente o node
# "ClickSign - Listar Pastas (auxiliar)" (está solto no canvas, sem conexão),
# copie o "id" da pasta desejada no resultado e cole aqui.
CLICKSIGN_FOLDER_ID=

# Gerado ao registrar o webhook via POST /api/v3/webhooks (ver README/INSTALACAO).
# Necessário para validar o header Content-Hmac no Workflow 2.
CLICKSIGN_WEBHOOK_SECRET=

# =============================================================================
# OUTLOOK SMTP — usado apenas para a mensagem de CONFIRMAÇÃO pós-assinatura
# (o convite/link de assinatura em si é enviado pelo próprio ClickSign)
# =============================================================================
OUTLOOK_SMTP_HOST=smtp-mail.outlook.com
OUTLOOK_SMTP_PORT=587
OUTLOOK_SMTP_EMAIL=
OUTLOOK_SMTP_PASSWORD=
OUTLOOK_FROM_EMAIL=

# =============================================================================
# TWILIO — WhatsApp, usado apenas para a mensagem de CONFIRMAÇÃO pós-assinatura
# Número precisa estar habilitado para WhatsApp Business/Sandbox.
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+55119XXXXXXXX

# =============================================================================
# DOCUMENTO A SER ASSINADO
# =============================================================================
DOCUMENTO_PATH=/home/node/n8n/documentos/termo-whatsapp-lgpd.pdf
DOCUMENTO_TITULO=Termo de Ciencia e Responsabilidade WhatsApp LGPD

# =============================================================================
# RELATÓRIO DIÁRIO (Workflow 3)
# =============================================================================
GESTOR_EMAIL=gestor@tchea.com.br
