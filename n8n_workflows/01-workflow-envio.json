      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fs = require('fs'); const { PDFDocument, StandardFonts, rgb } = require('pdf-lib'); const items = $input.all(); const results = []; const clicksignEnv = $env.CLICKSIGN_ENV || 'sandbox'; const baseUrl = clicksignEnv === 'production' ? $env.CLICKSIGN_API_URL_PRODUCTION : $env.CLICKSIGN_API_URL_SANDBOX; const folderId = ($env.CLICKSIGN_FOLDER_ID || '').trim(); const pdfTemplateBytes = fs.readFileSync($env.DOCUMENTO_PATH); const deadline = new Date(); deadline.setDate(deadline.getDate() + 30); function escapeSql(value) { return String(value ?? '').replace(/'/g, \"''\"); } function somenteDigitos(value) { return String(value ?? '').replace(/\\D/g, ''); } const documentoTitulo = $env.DOCUMENTO_TITULO || 'Documento para assinatura'; for (const item of items) { const nome = (item.json.nome || '').trim(); const cpf = (item.json.cpf || '').trim(); const email = (item.json.email || '').trim(); const telefoneDigitos = somenteDigitos(item.json.telefone); const local = (item.json.local_assinatura || '').trim(); if (!nome || !cpf || !email) { throw new Error('Registro invalido no CSV (faltando nome/cpf/email): ' + JSON.stringify(item.json)); } const telefoneE164 = telefoneDigitos ? ('+55' + telefoneDigitos.replace(/^55/, '')) : ''; const dataAssinaturaExtenso = new Date().toLocaleDateString('pt-BR'); const pdfDoc = await PDFDocument.load(pdfTemplateBytes); const font = await pdfDoc.embedFont(StandardFonts.Helvetica); const pages = pdfDoc.getPages(); const ultimaPagina = pages[pages.length - 1]; ultimaPagina.drawText(nome, { x: 220, y: 526, size: 11, font: font, color: rgb(0, 0, 0) }); ultimaPagina.drawText(cpf, { x: 220, y: 507, size: 11, font: font, color: rgb(0, 0, 0) }); ultimaPagina.drawText(local + ' - ' + dataAssinaturaExtenso, { x: 220, y: 486, size: 11, font: font, color: rgb(0, 0, 0) }); const pdfEstampadoBytes = await pdfDoc.save(); const documentoBase64 = 'data:application/pdf;base64,' + Buffer.from(pdfEstampadoBytes).toString('base64'); const envelopePayload = { data: { type: 'envelopes', attributes: { name: documentoTitulo + ' - ' + nome, deadline_at: deadline.toISOString(), locale: 'pt-BR', auto_close: true, remind_interval: '3', block_after_refusal: false, default_subject: 'Solicitacao de Assinatura - ' + documentoTitulo, default_message: 'Ola ' + nome + ', por favor confirme e assine o documento. CPF: ' + cpf + '. Local: ' + local + '.', deadline_partial_signature_action: 'closed' } } }; if (folderId) { envelopePayload.data.relationships = { folder: { data: { type: 'folders', id: folderId } } }; } results.push({ json: { nome_completo: nome, cpf: cpf, email: email, telefone: telefoneE164, telefone_digitos: telefoneDigitos, local_assinatura: local, clicksign_base_url: baseUrl, clicksign_folder_id: folderId, documento_titulo: documentoTitulo, envelope_payload_json: JSON.stringify(envelopePayload), documento_base64: documentoBase64, nome_completo_sql: escapeSql(nome), cpf_sql: escapeSql(cpf), email_sql: escapeSql(email), telefone_sql: escapeSql(telefoneE164), local_assinatura_sql: escapeSql(local) } }); } return results;"
      }
